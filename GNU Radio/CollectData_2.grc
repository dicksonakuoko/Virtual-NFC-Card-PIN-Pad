- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\nimport pmt\nimport logging\n\nlogger = logging.getLogger('grc')\n\
      logging.basicConfig(level=logging.DEBUG)\n\nclass blk(gr.basic_block):  # other\
      \ base classes are basic_block, decim_block, interp_block\n    \"\"\"Embedded\
      \ Python Block example - a simple multiply const\"\"\"\n\n    def __init__(\n\
      \        self,\n        tx_fs=12.5e6,\n        ask_percent=1.0,\n        flagBits='00100100',\n\
      \        commandCode=0b00000001,\n        maskLength=0b00000000\n    ):  # only\
      \ default arguments here\n        \"\"\"arguments to this function show up as\
      \ parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Generate Command Data',   # will show up in GRC\n       \
      \     in_sig=[],\n            out_sig=[np.complex64]\n        )\n        self.tx_fs\
      \ = tx_fs\n        self.ask_percent = ask_percent\n        self.flagBits = str(flagBits)\n\
      \        self.commandCode = commandCode\n        self.maskLength = maskLength\n\
      \        self.data_generated = False  # Add this attribute to track if data\
      \ is generated\n        self.command_data = None\n        self.command_data_len\
      \ = 0\n        self.current_index = 0\n        self.message_port_register_out(pmt.intern(\"\
      tx_len\"))\n\n    def work(self, input_items, output_items):\n        \n   \
      \     ## Generate Data\n        if not self.data_generated:\n            logger.debug(\"\
      Flagbits: \" + self.flagBits)\n            flagBits = int(self.flagBits, 2)\n\
      \            self.command_data = generateCommandData(\n                self.tx_fs,\n\
      \                self.ask_percent,\n                flagBits,\n            \
      \    self.commandCode,\n                self.maskLength\n            )\n   \
      \         self.command_data_len = len(self.command_data)\n            self.message_port_pub(\n\
      \                pmt.intern(\"tx_len\"),\n                pmt.from_long(self.command_data_len)\n\
      \            )\n            self.data_generated = True\n            logger.debug(\"\
      DATA GENERATED\")\n        \n        num_output_items = len(output_items[0])\n\
      \        end_index = self.current_index + num_output_items\n        \n     \
      \   ## Output data\n        try:\n            if end_index <= self.command_data_len:\n\
      \                output_items[0][:] = self.command_data[\n                 \
      \   self.current_index:end_index\n                ]\n                self.current_index\
      \ = end_index\n            else:\n                remaining_items = self.command_data_len\
      \ - self.current_index\n                output_items[0][:remaining_items] =\
      \ self.command_data[\n                    self.current_index:self.command_data_len\n\
      \                ]\n                output_items[0][remaining_items:] = self.command_data[\n\
      \                    :num_output_items - remaining_items\n                ]\n\
      \                self.current_index = num_output_items - remaining_items\n \
      \       except:\n            self.data_generated = False\n            self.command_data_len\
      \ = 0\n            self.current_index = 0\n            remaining_items = 0\n\
      \            output_items[0][:] = 0\n            return 0\n\n        return\
      \ len(output_items[0])\n\n\ndef generateCommandData(tx_fs, ask_percent, flagBits,\
      \ commandCode, maskLength):\n\n    rf_reset_length = round((8160e-6)/(1/tx_fs))\n\
      \    data_bytes = [flagBits, commandCode, maskLength]\n    CRC = calculateCRC(data_bytes)\n\
      \n    ## Rearrange Bits for Transmission\n    flagBits = bin(flagBits)[2:].zfill(8)\n\
      \    commandCode = bin(commandCode)[2:].zfill(8)\n    maskLength = bin(maskLength)[2:].zfill(8)\n\
      \n    rearranged_flagBits = ''\n    for i in range(len(flagBits) - 1, 0, -2):\n\
      \        bitpair = flagBits[i-1:i+1]\n        rearranged_flagBits = rearranged_flagBits\
      \ + bitpair\n\n    rearranged_commandCode = ''\n    for i in range(len(commandCode)\
      \ - 1, 0, -2):\n        bitpair = commandCode[i-1:i+1]\n        rearranged_commandCode\
      \ = rearranged_commandCode + bitpair\n\n    rearranged_maskLength = ''\n   \
      \ for i in range(len(maskLength) - 1, 0, -2):\n        bitpair = maskLength[i-1:i+1]\n\
      \        rearranged_maskLength = rearranged_maskLength + bitpair\n\n    rearranged_CRC\
      \ = ''\n    for i in range(len(CRC) - 1, 0, -2):\n        bitpair = CRC[i-1:i+1]\n\
      \        rearranged_CRC = rearranged_CRC + bitpair\n\n    # logger.debug(rearranged_flagBits)\n\
      \    # logger.debug(rearranged_commandCode)\n    # logger.debug(rearranged_maskLength)\n\
      \    # logger.debug(rearranged_CRC)\n    # rearranged_flagBits = '10011000'\n\
      \    # rearranged_commandCode = '01000000'\n    # rearranged_maskLength = '00000000'\n\
      \    # rearranged_CRC = '1001111110100000'\n\n    command = (\n        rearranged_flagBits\n\
      \        + rearranged_commandCode\n        + rearranged_maskLength\n       \
      \ + rearranged_CRC\n    )\n\n    command_data = modulateCommand(command, tx_fs,\
      \ ask_percent)\n    command_data = modulateSOF_EOF(command_data, tx_fs, ask_percent)\n\
      \    command_data = modulateSlotData(\n        command_data,\n        tx_fs,\n\
      \        ask_percent,\n        flagBits\n    )\n    \n    command_data = np.append(\n\
      \        command_data,\n        np.zeros(rf_reset_length,)\n    )  # Add RF\
      \ Reset after command\n    \n    command_data = addSineWave(command_data, tx_fs,\
      \ 60000)\n\n    return command_data\n\n\ndef calculateCRC(data_bytes):\n   \
      \ # Constants\n    POLYNOMIAL = 0x8408  # x^16 + x^12 + x^5 + 1\n    PRESET_VALUE\
      \ = 0xFFFF\n    NUMBER_OF_BYTES = len(data_bytes)\n    \n    current_crc_value\
      \ = PRESET_VALUE\n    \n    for i in range(NUMBER_OF_BYTES):\n        current_crc_value\
      \ = current_crc_value ^ data_bytes[i]\n\n        for j in range(8):\n      \
      \      if current_crc_value & 0x0001:\n                current_crc_value = (\n\
      \                    current_crc_value >> 1\n                ) ^ POLYNOMIAL\n\
      \            else:\n                current_crc_value = current_crc_value >>\
      \ 1\n\n    inverted_crc_value = ~current_crc_value\n    unsigned_integer = inverted_crc_value\
      \ + (1 << 16)\n    CRC = bin(unsigned_integer)[2:].zfill(16)\n\n    return CRC\n\
      \        \n\ndef modulateCommand(command, tx_fs, ask_percent):\n    \n    pair_samples\
      \ = round((75.52e-6)/(1/tx_fs))\n    low_percent = 1 - ask_percent\n    low_samples\
      \ = round((9.44e-06)/(1/tx_fs))\n    low_data = np.ones(low_samples) * low_percent\n\
      \    \n    data = []\n\n    for i in range(0, len(command), 2):\n        pair\
      \ = command[i:i+2]\n        pair_data = np.ones(pair_samples)\n\n        match\
      \ pair:\n            case \"00\":\n                high_samples = round((9.44e-06)/(1/tx_fs))\n\
      \                pair_data[\n                    high_samples:high_samples+low_samples\n\
      \                ] = low_data\n\n            case \"01\":\n                high_samples\
      \ = round((28.32e-06)/(1/tx_fs))\n                pair_data[\n             \
      \       high_samples:high_samples+low_samples\n                ] = low_data\n\
      \n            case \"10\":\n                high_samples = round((47.2e-06)/(1/tx_fs))\n\
      \                pair_data[\n                    high_samples:high_samples+low_samples\n\
      \                ] = low_data\n\n            case \"11\":\n                high_samples\
      \ = round((66.08e-06)/(1/tx_fs))\n                pair_data[\n             \
      \       high_samples:high_samples+low_samples\n                ] = low_data\n\
      \n        data = np.append(data, pair_data)\n\n    return data\n\n\ndef modulateSOF_EOF(data,\
      \ tx_fs, ask_percent):\n    SOF_length = round((75.52e-06)/(1/tx_fs))\n    EOF_length\
      \ = round(SOF_length/2)\n    \n    low_percent = 1-ask_percent\n    low_samples\
      \ = round((9.44e-06)/(1/tx_fs))\n    low_data = np.ones(low_samples) * low_percent\n\
      \n    SOF = np.ones(SOF_length)\n    SOF[:low_samples] = low_data\n\n    high_samples\
      \ = round((47.2e-06)/(1/tx_fs))\n    SOF[\n        high_samples:high_samples+low_samples\n\
      \    ] = low_data\n\n    EOF = np.ones(EOF_length)\n\n    high_samples = round((18.88e-06)/(1/tx_fs))\n\
      \    EOF[\n        high_samples:high_samples + low_samples\n    ] = low_data\n\
      \n    data = np.append(SOF, data)\n    data = np.append(data, EOF)\n\n    return\
      \ data\n\n\ndef modulateSlotData(data, tx_fs, ask_percent, flagBits):\n    slot_flag\
      \ = flagBits[2]\n    rate_flag = flagBits[6]\n    inv_flag = flagBits[5]\n \
      \   \n    low_percent = 1-ask_percent\n    low_samples = round((9.44e-06)/(1/tx_fs))\n\
      \    low_data = np.ones(low_samples) * low_percent\n\n    EOF_length = round((37.76e-06)/(1/tx_fs))\n\
      \    EOF = np.ones(EOF_length)\n\n    high_samples = round((18.88e-06)/(1/tx_fs))\n\
      \    EOF[\n        high_samples:high_samples + low_samples\n    ] = low_data\n\
      \n    if rate_flag == '1':\n        slot_length = round(8160e-06/(1/tx_fs))\n\
      \    else:\n        slot_length = round(20332e-06/(1/tx_fs))\n\n    slot = np.ones(slot_length)\n\
      \    data = np.append(slot, data)\n\n    if slot_flag == '0' and inv_flag ==\
      \ '1':\n        slot = np.append(slot, EOF)\n\n        for i in range(16):\n\
      \            data = np.append(data, slot)\n    else:\n        data = np.append(\n\
      \            data,\n            np.ones(slot_length)\n        )\n\n    return\
      \ data\n\n\ndef addSineWave(data, tx_fs, sinewave_fs):\n    data_length = len(data)\n\
      \    duration = data_length / tx_fs\n\n    t = np.linspace(\n        0,\n  \
      \      duration,\n        data_length,\n        endpoint=False,\n        dtype=np.complex64\n\
      \    )  # Time array\n\n    # Generate the complex sine wave\n    sine_wave\
      \ = np.exp(\n        2j * np.pi * sinewave_fs * t\n    ).astype(np.complex64)\n\
      \n    data = sine_wave * data\n\n    return data"
    affinity: ''
    alias: ''
    ask_percent: '1.0'
    commandCode: '0b00000001'
    comment: ''
    flagBits: '''00100100'''
    maskLength: '0b00000000'
    maxoutbuf: '0'
    minoutbuf: '0'
    tx_fs: tx_fs
  states:
    _io_cache: ('Generate Command Data', 'blk', [('tx_fs', '12500000.0'), ('ask_percent',
      '1.0'), ('flagBits', "'00100100'"), ('commandCode', '1'), ('maskLength', '0')],
      [], [('0', 'complex', 1), ('tx_len', 'message', 1)], 'Embedded Python Block
      example - a simple multiply const', ['ask_percent', 'commandCode', 'flagBits',
      'maskLength', 'tx_fs'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 144.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__ will\nbe the parameters. All of them\
      \ are required to have default values!\n\"\"\"\n\nimport numpy as np\nfrom gnuradio\
      \ import gr\nimport pmt\nimport logging\nimport os\nfrom pathlib import Path\n\
      from scipy.stats.stats import pearsonr\n\nlogger = logging.getLogger('grc')\n\
      logging.basicConfig(level=logging.DEBUG)\n\n\nclass SaveNumpyArrayBlock(gr.sync_block):\n\
      \n    def __init__(\n        self,\n        rx_fs=2e6,\n        tx_fs=12.5e6,\n\
      \        flagBits='00100100',\n        signals_requested=200,\n        card=1,\n\
      \        button=0\n    ):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Save Card Button Signals',\n            in_sig=[np.complex64],\n\
      \            out_sig=[]\n        )\n\n        ## Make variables persistent with\
      \ each loop\n        self.data = []\n        self.rx_fs = rx_fs\n        self.tx_fs\
      \ = tx_fs\n        self.flagBits = str(flagBits)\n        self.signals_found\
      \ = 0\n        self.signals_requested = signals_requested\n\n        # Disable\
      \ the pause at 50 responses\n        self.responses_per_placement = self.signals_requested\n\
      \n        # Pause collection after each group\n        self.collection_paused\
      \ = False\n\n        self.tx_len = 0\n        self.card = int(card)\n      \
      \  self.button = int(button)\n\n        if self.card < 1 or self.card > 40:\n\
      \            raise ValueError(\n                \"card must be between 1 and\
      \ 40\"\n            )\n\n        if self.button < 0 or self.button > 11:\n \
      \           raise ValueError(\n                \"button must be between 0 and\
      \ 11\"\n            )\n\n        if len(self.flagBits) != 8:\n            raise\
      \ ValueError(\n                \"flagBits must contain exactly 8 bits\"\n  \
      \          )\n\n        if any(bit not in ('0', '1') for bit in self.flagBits):\n\
      \            raise ValueError(\n                \"flagBits must contain only\
      \ 0 and 1\"\n            )\n\n        self.message_port_register_in(\n     \
      \       pmt.intern(\"tx_len\")\n        )\n\n        self.set_msg_handler(\n\
      \            pmt.intern(\"tx_len\"),\n            self.handle_msg\n        )\n\
      \n        logger.debug(\n            \"Configured collection: Card \"\n    \
      \        + str(self.card)\n            + \", Button \"\n            + str(self.button)\n\
      \            + \", FlagBits \"\n            + self.flagBits\n        )\n\n\n\
      \    # Get tx_len from generate command data block\n    def handle_msg(self,\
      \ msg):\n        self.tx_len = pmt.to_long(msg)\n\n\n    def work(self, input_items,\
      \ output_items):\n\n        # Pause after each group of responses.\n       \
      \ # Reposition the induced coil, stop the flowgraph,\n        # and restart\
      \ it to continue collection.\n        if self.collection_paused:\n         \
      \   return 0\n\n        # Use manually selected flagBits from GRC\n        flagBits\
      \ = self.flagBits\n\n        # Change variables based on data-rate and subcarrier\
      \ combination\n        match flagBits[6:8]:\n\n            case '00':\n    \
      \            data_directory = Path(\n                    '/home/cse/pinpad/myenv/GNURadio_1/'\n\
      \                    'Correlation_Responses/'\n                    'OneSubcarrierLowDataRate'\n\
      \                )\n\n                SOF_time = (151.04e-06) * 4\n        \
      \        bit_time = (37.76e-06) * 4\n\n            case '01':\n            \
      \    data_directory = Path(\n                    '/home/cse/pinpad/myenv/GNURadio_1/'\n\
      \                    'Correlation_Responses/'\n                    'TwoSubcarriersLowDataRate'\n\
      \                )\n\n                SOF_time = (149.85e-06) * 4\n        \
      \        bit_time = (37.46e-06) * 4\n\n            case '10':\n            \
      \    data_directory = Path(\n                    '/home/cse/pinpad/myenv/GNURadio_1/'\n\
      \                    'Correlation_Responses/'\n                    'OneSubcarrierHighDataRate'\n\
      \                )\n\n                SOF_time = 151.04e-06\n              \
      \  bit_time = 37.76e-06\n\n            case '11':\n                data_directory\
      \ = Path(\n                    '/home/cse/pinpad/myenv/GNURadio_1/'\n      \
      \              'Correlation_Responses/'\n                    'TwoSubcarriersHighDataRate'\n\
      \                )\n\n                SOF_time = 149.85e-06\n              \
      \  bit_time = 37.46e-06\n\n        # Create a separate folder for each card\n\
      \        card_directory = (\n            data_directory\n            / ('card'\
      \ + str(self.card))\n        )\n\n        os.makedirs(\n            card_directory,\n\
      \            exist_ok=True\n        )\n\n        # Save one file for each button\
      \ position\n        button_name = (\n            'button'\n            + str(self.button)\n\
      \            + '.npy'\n        )\n\n        self.card_sig_path = (\n       \
      \     card_directory\n            / button_name\n        )\n\n        # Correlation\
      \ signal remains inside the mode directory\n        self.corr_sig_path = (\n\
      \            data_directory\n            / 'corr_signal.npy'\n        )\n\n\
      \        SOF_length = round(\n            SOF_time / (1 / self.rx_fs)\n    \
      \    )\n\n        bit_length = round(\n            bit_time / (1 / self.rx_fs)\n\
      \        )\n\n        response_bits = 8\n\n        response_length = (\n   \
      \         SOF_length\n            + bit_length * response_bits\n        )\n\n\
      \        # Create the button response file if it does not exist\n        if\
      \ not self.card_sig_path.is_file():\n            np.save(\n                self.card_sig_path,\n\
      \                np.zeros(\n                    (0, response_length),\n    \
      \                dtype=np.complex64\n                )\n            )\n\n  \
      \      # Load the known response used for correlation filtering\n        self.corr_signal\
      \ = np.load(\n            self.corr_sig_path,\n            allow_pickle=True\n\
      \        )\n\n        # Process after collecting the required buffer size\n\
      \        if len(self.data) >= 2000000:\n\n            prev_cards = np.load(\n\
      \                self.card_sig_path,\n                allow_pickle=True\n  \
      \          )\n\n            self.signals_found = (\n                prev_cards.shape[0]\n\
      \            )\n\n            buffer = np.array(\n                self.data,\n\
      \                dtype=np.complex64\n            )\n\n            try:\n   \
      \             card_signals = findCardSignals(\n                    buffer,\n\
      \                    self.rx_fs,\n                    self.tx_fs,\n        \
      \            flagBits,\n                    self.tx_len\n                )\n\
      \n                card_signals = normalize_data(\n                    self,\n\
      \                    card_signals\n                )\n\n            except Exception\
      \ as error:\n                logger.debug(\n                    \"Signal extraction\
      \ error: \"\n                    + str(error)\n                )\n\n       \
      \         self.data = []\n                return 0\n\n            ## Remove\
      \ signals that are not similar to the correlation signal\n            row_to_remove\
      \ = []\n\n            for i in range(\n                card_signals.shape[0]\n\
      \            ):\n\n                diff = pearsonr(\n                    np.abs(self.corr_signal),\n\
      \                    np.abs(card_signals[i])\n                )[0]\n\n     \
      \           if diff < 0.8:\n                    row_to_remove.append(i)\n\n\
      \            card_signals = np.delete(\n                card_signals,\n    \
      \            row_to_remove,\n                axis=0\n            )\n\n     \
      \       ## Determine total number of responses still required\n            signals_remaining\
      \ = (\n                self.signals_requested\n                - self.signals_found\n\
      \            )\n\n            ## Determine progress within the current response\
      \ batch\n            responses_in_current_batch = (\n                self.signals_found\n\
      \                % self.responses_per_placement\n            )\n\n         \
      \   ## Determine how many more responses can be collected\n            ## before\
      \ pausing\n            responses_until_pause = (\n                self.responses_per_placement\n\
      \                - responses_in_current_batch\n            )\n\n           \
      \ ## Limit collection by:\n            ## 1. Total responses remaining\n   \
      \         ## 2. Responses remaining in the current batch\n            ## 3.\
      \ Number of valid responses currently detected\n            signals_remaining\
      \ = min(\n                signals_remaining,\n                responses_until_pause,\n\
      \                card_signals.shape[0]\n            )\n\n            ## Add\
      \ and save newly found responses\n            card_signals = np.vstack(\n  \
      \              (\n                    prev_cards,\n                    card_signals[\n\
      \                        :signals_remaining\n                    ]\n       \
      \         )\n            )\n\n            self.signals_found = (\n         \
      \       card_signals.shape[0]\n            )\n\n            logger.debug(\n\
      \                \"Card \"\n                + str(self.card)\n             \
      \   + \", Button \"\n                + str(self.button)\n                + \"\
      , Signals Found: \"\n                + str(self.signals_found)\n           \
      \     + \"/\"\n                + str(self.signals_requested)\n            )\n\
      \n            np.save(\n                self.card_sig_path,\n              \
      \  card_signals\n            )\n\n            ## Pause after collecting each\
      \ group\n            if (\n                self.signals_found > 0\n        \
      \        and self.signals_found\n                < self.signals_requested\n\
      \                and self.signals_found\n                % self.responses_per_placement\
      \ == 0\n            ):\n\n                logger.debug(\n                  \
      \  \"==================================================\"\n                )\n\
      \n                logger.debug(\n                    \"PAUSED: Card \"\n   \
      \                 + str(self.card)\n                    + \", Button \"\n  \
      \                  + str(self.button)\n                    + \" has collected\
      \ \"\n                    + str(self.signals_found)\n                    + \"\
      /\"\n                    + str(self.signals_requested)\n                   \
      \ + \" responses.\"\n                )\n\n                logger.debug(\n  \
      \                  \"Reposition the induced button coil.\"\n               \
      \ )\n\n                logger.debug(\n                    \"Then stop and restart\
      \ the flowgraph \"\n                    \"to continue collecting responses.\"\
      \n                )\n\n                logger.debug(\n                    \"\
      Current data file: \"\n                    + str(self.card_sig_path)\n     \
      \           )\n\n                logger.debug(\n                    \"==================================================\"\
      \n                )\n\n                self.collection_paused = True\n     \
      \           self.data = []\n\n                return 0\n\n            ## Check\
      \ whether collection is complete\n            if (\n                self.signals_found\n\
      \                >= self.signals_requested\n            ):\n\n             \
      \   card_signals = normalize_data(\n                    self,\n            \
      \        card_signals\n                )\n\n                np.save(\n     \
      \               self.card_sig_path,\n                    card_signals\n    \
      \            )\n\n                logger.debug(\n                    \"-------\
      \ CARD \"\n                    + str(self.card)\n                    + \", BUTTON\
      \ \"\n                    + str(self.button)\n                    + \", FLAGBITS\
      \ \"\n                    + str(self.flagBits)\n                    + \" COMPLETED\
      \ -------\"\n                )\n\n                logger.debug(\n          \
      \          \"Total responses saved: \"\n                    + str(self.signals_found)\n\
      \                )\n\n                logger.debug(\n                    \"\
      Saved file: \"\n                    + str(self.card_sig_path)\n            \
      \    )\n\n                self.data = []\n\n            else:\n            \
      \    self.data = []\n\n            return 0\n\n        ## Collect incoming samples\n\
      \        elif len(self.data) <= 2000000:\n\n            self.data.extend(\n\
      \                input_items[0]\n            )\n\n            return len(\n\
      \                input_items[0]\n            )\n\n        return 0\n\n\ndef\
      \ findCardSignals(\n    data,\n    rx_fs,\n    tx_fs,\n    flagBits,\n    tx_len\n\
      ):\n    abs_data = np.abs(data)\n\n    ## Get the correct timings of received\
      \ data\n    rate_flag = flagBits[6]\n\n    if rate_flag == '1':\n        slot_length\
      \ = round(\n            8160e-06 / (1 / rx_fs)\n        )\n    else:\n     \
      \   slot_length = round(\n            20332e-06 / (1 / rx_fs)\n        )\n\n\
      \    rf_reset_length = round(\n        8160e-06 / (1 / rx_fs)\n    )\n\n   \
      \ command_time = (\n        tx_len / tx_fs\n    )\n\n    command_length = round(\n\
      \        command_time / (1 / rx_fs)\n        + 2.5e-04 / (1 / rx_fs)\n    )\n\
      \n    N = 50\n    rho = 15\n\n    match flagBits[6:8]:\n\n        case '00':\n\
      \            SOF_time = (\n                151.04e-06\n            ) * 4\n\n\
      \            SOF_low_time = (\n                56.64e-06\n            ) * 4\n\
      \n            bit_time = (\n                37.76e-06\n            ) * 4\n\n\
      \        case '01':\n            SOF_time = (\n                149.85e-06\n\
      \            ) * 4\n\n            SOF_low_time = 0\n\n            bit_time =\
      \ (\n                37.46e-06\n            ) * 4\n\n        case '10':\n  \
      \          SOF_time = 151.04e-06\n            SOF_low_time = 56.64e-06\n   \
      \         bit_time = 37.76e-06\n\n        case '11':\n            SOF_time =\
      \ 149.85e-06\n            SOF_low_time = 0\n            bit_time = 37.46e-06\n\
      \n    SOF_length = round(\n        SOF_time / (1 / rx_fs)\n    )\n\n    SOF_low_length\
      \ = round(\n        SOF_low_time / (1 / rx_fs)\n    )\n\n    bit_length = round(\n\
      \        bit_time / (1 / rx_fs)\n    )\n\n    response_bits = 8\n\n    response_length\
      \ = (\n        SOF_length\n        + bit_length * response_bits\n    )\n\n \
      \   tx_start = 0\n\n    card_signals = (\n        [None] * response_length\n\
      \    )\n\n    ## Find when the received signal is low\n    start = findRFreset(data)\n\
      \    data = data[start:]\n\n    ## Loop through the buffer to find card responses\n\
      \    while (\n        tx_start\n        + 2 * command_length\n        < len(abs_data)\n\
      \    ):\n\n        abs_data = np.abs(data)\n\n        # Find the start of command\
      \ transmission\n        for i in range(\n            0,\n            len(abs_data),\n\
      \            100\n        ):\n            window_size = 100\n\n            if\
      \ (\n                i + window_size\n                > len(abs_data) - 1\n\
      \            ):\n                window_size = (\n                    len(abs_data)\n\
      \                    - i\n                    - 1\n                )\n\n   \
      \         delta = np.abs(\n                abs_data[\n                    i\
      \ + window_size\n                ]\n                - abs_data[i]\n        \
      \    )\n\n            if delta > 0.1:\n                tx_start = i\n      \
      \          break\n\n            tx_start = None\n\n        if tx_start is None:\n\
      \            return card_signals[1:]\n\n        offset = (\n            tx_start\n\
      \            + command_length\n            - slot_length\n            - rf_reset_length\n\
      \        )\n\n        # Find the start of the card response\n        response_start\
      \ = findResponseStart(\n            data[offset:],\n            N,\n       \
      \     rho\n        )\n\n        offset = (\n            offset\n           \
      \ + response_start\n            - SOF_low_length\n        )\n\n        # Extract\
      \ the card response\n        card_signal = data[\n            offset:\n    \
      \        offset + response_length\n        ]\n\n        card_signals = np.vstack(\n\
      \            (\n                card_signals,\n                card_signal\n\
      \            )\n        )\n\n        # Find the next transmission interval\n\
      \        data = data[\n            tx_start\n            + command_length\n\
      \            - rf_reset_length:\n        ]\n\n        start = findRFreset(data)\n\
      \        data = data[start:]\n\n    return card_signals[1:]\n\n\ndef findResponseStart(\n\
      \    data,\n    N,\n    rho\n):\n    data = np.abs(data)\n    delta = np.abs(np.diff(data))\n\
      \n    midPoint = int(\n        np.floor(N / 2) + 1\n    )\n\n    deltaSegment\
      \ = delta[\n        midPoint:N\n    ]\n\n    sigma = (\n        rho\n      \
      \  * np.mean(deltaSegment)\n    )\n\n    start = np.where(\n        delta >\
      \ sigma\n    )[0][0]\n\n    return start\n\n\ndef findRFreset(data):\n\n   \
      \ window_size = 1000\n\n    for i in range(\n        0,\n        len(data),\n\
      \        window_size\n    ):\n        avg = np.mean(\n            abs(\n   \
      \             data[\n                    i:\n                    i + window_size\n\
      \                ]\n            )\n        )\n\n        if avg <= 0.001:\n \
      \           return i\n\n\n## Uses a sliding window and mean to determine similarity\n\
      def differences(\n    arr1,\n    arr2\n):\n    windows_size = 10\n    diffs\
      \ = []\n\n    for i in range(\n        0,\n        len(arr1) - windows_size,\n\
      \        windows_size\n    ):\n        arr1_mean = np.mean(\n            np.abs(\n\
      \                arr1[\n                    i:\n                    i + windows_size\n\
      \                ]\n            )\n        )\n\n        arr2_mean = np.mean(\n\
      \            np.abs(\n                arr2[\n                    i:\n      \
      \              i + windows_size\n                ]\n            )\n        )\n\
      \n        diff = np.abs(\n            arr1_mean\n            - arr2_mean\n \
      \       )\n\n        diffs = np.append(\n            diffs,\n            diff\n\
      \        )\n\n    return np.mean(diffs)\n\n\n## Make each input response have\
      \ the same mean as the correlation signal\ndef normalize_data(\n    self,\n\
      \    data\n):\n    data = np.asarray(\n        data,\n        np.complex_\n\
      \    )\n\n    overall_mean_magnitude = np.mean(\n        np.abs(self.corr_signal)\n\
      \    )\n\n    row_means = np.mean(\n        np.abs(data),\n        axis=1\n\
      \    )\n\n    normalized_data = np.empty_like(\n        data,\n        dtype=np.complex_\n\
      \    )\n\n    for i in range(\n        data.shape[0]\n    ):\n        magnitudes\
      \ = np.abs(\n            data[i]\n        )\n\n        phases = np.angle(\n\
      \            data[i]\n        )\n\n        scale_factor = (\n            overall_mean_magnitude\n\
      \            / row_means[i]\n        )\n\n        new_magnitudes = (\n     \
      \       magnitudes\n            * scale_factor\n        )\n\n        normalized_data[i]\
      \ = (\n            new_magnitudes\n            * np.exp(\n                1j\
      \ * phases\n            )\n        )\n\n    return normalized_data"
    affinity: ''
    alias: ''
    button: '3'
    card: '16'
    comment: ''
    flagBits: '''00100100'''
    maxoutbuf: '0'
    minoutbuf: '0'
    rx_fs: rx_fs
    signals_requested: '200'
    tx_fs: tx_fs
  states:
    _io_cache: ('Save Card Button Signals', 'SaveNumpyArrayBlock', [('rx_fs', '2000000.0'),
      ('tx_fs', '12500000.0'), ('flagBits', "'00100100'"), ('signals_requested', '200'),
      ('card', '1'), ('button', '0')], [('0', 'complex', 1), ('tx_len', 'message',
      1)], [], '', ['button', 'card', 'flagBits', 'rx_fs', 'signals_requested', 'tx_fs'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 64.0]
    rotation: 0
    state: enabled
- name: epy_block_1_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nDigital SIC Embedded Python Block\n\nInput 0: y[n]    \
      \  = main RX signal from RF combiner output\nInput 1: x_ref[n]  = reference\
      \ RX signal from coupler/splitter path\nOutput: y_clean[n] = y[n] - estimated\
      \ self-interference\n\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\
      import logging\n\nlogger = logging.getLogger('grc')\nlogging.basicConfig(level=logging.DEBUG)\n\
      \n\nclass blk(gr.sync_block):\n\n    def __init__(\n        self,\n        enable_dsic=True,\n\
      \        num_taps=16,\n        mu=0.005,\n        eps=1e-10,\n        log_interval=100\n\
      \    ):\n        gr.sync_block.__init__(\n            self,\n            name='Digital\
      \ SIC',\n            in_sig=[np.complex64, np.complex64],\n            out_sig=[np.complex64]\n\
      \        )\n\n        self.enable_dsic = bool(enable_dsic)\n        self.num_taps\
      \ = int(num_taps)\n        self.mu = float(mu)\n        self.eps = float(eps)\n\
      \        self.log_interval = int(log_interval)\n\n        self.w = np.zeros(\n\
      \            self.num_taps,\n            dtype=np.complex64\n        )\n\n \
      \       self.x_hist = np.zeros(\n            self.num_taps,\n            dtype=np.complex64\n\
      \        )\n\n        self.counter = 0\n\n        logger.debug(\n          \
      \  \"Digital SIC initialized: \"\n            + \"enable_dsic=\"\n         \
      \   + str(self.enable_dsic)\n            + \", num_taps=\"\n            + str(self.num_taps)\n\
      \            + \", mu=\"\n            + str(self.mu)\n        )\n\n    def work(self,\
      \ input_items, output_items):\n\n        y = input_items[0]\n        x_ref =\
      \ input_items[1]\n        y_clean = output_items[0]\n\n        N = min(\n  \
      \          len(y),\n            len(x_ref),\n            len(y_clean)\n    \
      \    )\n\n        if N <= 0:\n            return 0\n\n        if not self.enable_dsic:\n\
      \            y_clean[:N] = y[:N]\n            return N\n\n        p_before_acc\
      \ = 0.0\n        p_after_acc = 0.0\n\n        for n in range(N):\n\n       \
      \     self.x_hist[1:] = self.x_hist[:-1]\n            self.x_hist[0] = x_ref[n]\n\
      \n            leakage_hat = np.vdot(\n                self.w,\n            \
      \    self.x_hist\n            )\n\n            error = y[n] - leakage_hat\n\n\
      \            y_clean[n] = error\n\n            ref_power = (\n             \
      \   np.vdot(\n                    self.x_hist,\n                    self.x_hist\n\
      \                ).real\n                + self.eps\n            )\n\n     \
      \       self.w = self.w + (\n                self.mu\n                * self.x_hist\n\
      \                * np.conj(error)\n                / ref_power\n           \
      \ )\n\n            p_before_acc += np.abs(y[n]) ** 2\n            p_after_acc\
      \ += np.abs(error) ** 2\n\n        self.counter += 1\n\n        if self.counter\
      \ % self.log_interval == 0:\n\n            p_before = (\n                p_before_acc\
      \ / max(N, 1)\n                + self.eps\n            )\n\n            p_after\
      \ = (\n                p_after_acc / max(N, 1)\n                + self.eps\n\
      \            )\n\n            sic_reduction_db = 10 * np.log10(\n          \
      \      p_before / p_after\n            )\n\n            logger.debug(\n    \
      \            \"Digital SIC reduction: \"\n                + str(round(sic_reduction_db,\
      \ 2))\n                + \" dB\"\n            )\n\n        return N"
    affinity: ''
    alias: ''
    comment: ''
    enable_dsic: 'True'
    eps: 1e-10
    log_interval: '100'
    maxoutbuf: '0'
    minoutbuf: '0'
    mu: '0.005'
    num_taps: '16'
  states:
    _io_cache: ('Digital SIC', 'blk', [('enable_dsic', 'True'), ('num_taps', '16'),
      ('mu', '0.005'), ('eps', '1e-10'), ('log_interval', '100')], [('0', 'complex',
      1), ('1', 'complex', 1)], [('0', 'complex', 1)], '', ['enable_dsic', 'eps',
      'log_interval', 'mu', 'num_taps'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 128.0]
    rotation: 0
    state: disabled
